# ==========================================
# SkillBridge Environment Configuration
# ==========================================

# Server Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL / NeonDB)
DATABASE_URL="postgresql://user:password@ep-sample-neon.region.neon.tech/skillbridge?sslmode=require"

# JWT Authentication
JWT_ACCESS_SECRET="super-secret-access-token-key-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Client Environment (Vite)
VITE_API_BASE_URL="http://localhost:5000/api/v1"
