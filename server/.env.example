# =========================================================================
# SkillBridge Server — Production Environment Variables
# =========================================================================

NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=https://skillbridge.dev

DATABASE_URL="postgresql://postgres:your_password@ep-sample-neon-db.us-east-2.aws.neon.tech/skillbridge?sslmode=require&connection_limit=10&pool_timeout=20"

JWT_ACCESS_SECRET="generate-a-strong-32-character-secret-key-for-access-token"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET="generate-a-strong-32-character-secret-key-for-refresh-token"
JWT_REFRESH_EXPIRES_IN=7d

GEMINI_API_KEY=""
